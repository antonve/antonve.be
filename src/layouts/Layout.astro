---
import '../fonts/fonts.css'
import '../styles/globals.css'
import merriweatherLatin from '../fonts/merriweather-latin.woff2?url'
import openSansLatin from '../fonts/open-sans-latin.woff2?url'

interface Props {
  title?: string
}

const { title = 'Anton Van Eechaute' } = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="preload" href={openSansLatin} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={merriweatherLatin} as="font" type="font/woff2" crossorigin="anonymous" />
  </head>
  <body>
    <div class="font-sans max-w-4xl mx-auto px-4 md:px-6">
      <slot />
    </div>
  </body>
</html>
