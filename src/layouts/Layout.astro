---
import { getImage } from 'astro:assets'
import profilePic from '../assets/profile-pic.jpg'
import '../fonts/fonts.css'
import '../styles/globals.css'
import merriweatherLatin from '../fonts/merriweather-latin.woff2?url'
import openSansLatin from '../fonts/open-sans-latin.woff2?url'

interface Props {
  title?: string
  description: string
  noindex?: boolean
}

const { title = 'Anton Van Eechaute', description, noindex = false } = Astro.props
// File-format builds include .html in Astro.url; public routes are extensionless.
const canonicalPath = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '')
const canonicalURL = new URL(canonicalPath, Astro.site).href
const shareImage = await getImage({ src: profilePic, format: 'jpg', quality: 85 })
const shareImageURL = new URL(shareImage.src, Astro.site).href
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonicalURL} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Anton Van Eechaute" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:image" content={shareImageURL} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content={String(profilePic.width)} />
        <meta property="og:image:height" content={String(profilePic.height)} />
        <meta property="og:image:alt" content="Portrait of Anton Van Eechaute" />
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={shareImageURL} />
        <meta name="twitter:image:alt" content="Portrait of Anton Van Eechaute" />
      </>
    )}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="preload" href={openSansLatin} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={merriweatherLatin} as="font" type="font/woff2" crossorigin="anonymous" />
    {/* Apply a stored theme before first paint, and flip it from the header's toggle.
        Without a stored choice the page follows the system preference in CSS. */}
    <script is:inline>
      const root = document.documentElement
      try { if (localStorage.theme) root.dataset.theme = localStorage.theme } catch {}
      document.addEventListener('click', event => {
        if (!event.target.closest('.theme-toggle')) return
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches
        root.dataset.theme = dark ? 'light' : 'dark'
        try { localStorage.theme = root.dataset.theme } catch {}
      })
    </script>
    <noscript><style>.theme-toggle { display: none }</style></noscript>
  </head>
  <body>
    <a href="#main" class="sr-only rounded-md font-semibold focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:bg-fg focus:px-4 focus:py-2 focus:text-bg">Skip to content</a>
    <div class="font-sans max-w-4xl mx-auto px-4 md:px-6">
      <slot />
    </div>
  </body>
</html>
