---
import { getCollection } from 'astro:content'
import Header from '../components/Header.astro'
import PostDate from '../components/PostDate.astro'
import Layout from '../layouts/Layout.astro'

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---

<Layout title="Anton Van Eechaute :: Blog" description="Articles and notes by Anton Van Eechaute.">
  <Header />
  <main class="max-w-2xl pb-16">
    <h1 class="title mb-10 md:mb-12">Blog</h1>
    {
      posts.length === 0 ? (
        <p class="text-fg-muted">No posts yet.</p>
      ) : (
        <ul class="divide-y divide-line">
          {posts.map(post => (
            <li class="py-8 first:pt-0">
              <h2 class="text-xl leading-snug font-bold sm:text-2xl">
                <a href={`/blog/${post.id}`} class="hover:text-accent">{post.data.title}</a>
              </h2>
              <p class="meta mt-1 mb-3"><PostDate date={post.data.date} /></p>
              <p class="my-0 text-[1.0625rem] leading-relaxed text-fg-muted">{post.data.description}</p>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</Layout>
