---
import { getCollection } from 'astro:content'

// Keep Blog out of the navigation until there is something to read.
const hasPosts = (await getCollection('blog')).length > 0
const links = [
  { href: '/', label: 'Home' },
  ...(hasPosts ? [{ href: '/blog', label: 'Blog' }] : []),
  { href: '/projects', label: 'Projects' },
  { href: '/books', label: 'Bookshelf' },
]
// File-format builds report /projects.html; posts live under /blog/.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/^\/index$/, '/')
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`))
const linkClass =
  'inline-flex min-h-11 items-center text-fg-muted decoration-mark decoration-2 underline-offset-[0.45em] transition-colors hover:text-fg aria-[current=page]:text-fg aria-[current=page]:underline'
---

<header class="relative mt-10 mb-12 flex max-w-xl flex-col items-start md:mt-20 md:mb-16 md:flex-row md:items-center md:gap-10">
  <a href="/" class="block rounded-sm">
    {/* The dark logo makes the translucent teal stripes opaque so they don't turn murky on the dark page.
        Two images rather than <picture>, because a media query can't follow the theme toggle. */}
    <img src="/img/logo.png" alt="Anton Van Eechaute, home" width="232" height="38" decoding="async" class="h-auto w-[180px] dark:hidden" />
    <img src="/img/logo-dark.png" alt="Anton Van Eechaute, home" width="232" height="38" decoding="async" class="hidden h-auto w-[180px] dark:block" />
  </a>
  <nav aria-label="Main" class="text-[1.0625rem] font-semibold">
    {/* Phones fold the links into a native disclosure; its button sits on the logo's row. */}
    <details class="group md:hidden">
      <summary class="absolute -top-2 -right-3 flex size-11 cursor-pointer list-none items-center justify-center rounded-md text-fg transition-colors hover:text-accent [&::-webkit-details-marker]:hidden">
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" class="size-6 group-open:hidden" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg viewBox="0 0 24 24" class="hidden size-6 group-open:block" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </summary>
      <div class="mt-4 flex flex-col items-start text-xl">
        {links.map(({ href, label }) => <a href={href} class={linkClass} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}
      </div>
    </details>
    <div class="hidden gap-x-7 md:flex">
      {links.map(({ href, label }) => <a href={href} class={linkClass} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}
    </div>
  </nav>
  {/* Phones put it beside the menu button; wider screens put it after the links. */}
  <button
    type="button"
    class="theme-toggle flex size-11 cursor-pointer items-center justify-center rounded-md text-fg-muted transition-colors hover:text-fg max-md:absolute max-md:-top-2 max-md:right-8 md:-ml-6"
  >
    <span class="sr-only dark:hidden">Switch to dark theme</span>
    <span class="sr-only hidden dark:inline">Switch to light theme</span>
    <svg viewBox="0 0 24 24" class="size-5 dark:hidden" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
    </svg>
    <svg viewBox="0 0 24 24" class="hidden size-5 dark:block" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
    </svg>
  </button>
</header>
