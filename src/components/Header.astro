---
import { getCollection } from 'astro:content'

// Keep Blog out of the navigation until there is something to read.
const hasPosts = (await getCollection('blog')).length > 0
const links = [
  { href: '/', label: 'Home' },
  ...(hasPosts ? [{ href: '/blog', label: 'Blog' }] : []),
  { href: '/projects', label: 'Projects' },
  { href: '/books', label: 'Bookshelf' },
]
---

<header class="relative mt-10 mb-10 flex max-w-xl flex-col items-start md:mt-20 md:mb-16 md:flex-row md:items-center md:gap-8">
  <img
    src="/img/logo.png"
    alt="Anton Van Eechaute"
    width="232"
    height="38"
    loading="lazy"
    decoding="async"
    class="h-auto w-[180px]"
  />
  <nav class="text-xl">
    {/* Phones fold the links into a native disclosure; its button sits on the logo's row. */}
    <details class="group md:hidden">
      <summary class="absolute -top-2 -right-3 flex size-11 cursor-pointer list-none items-center justify-center text-neutral-800 transition-colors hover:text-primary [&::-webkit-details-marker]:hidden">
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" class="size-6 group-open:hidden" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
        <svg viewBox="0 0 24 24" class="hidden size-6 group-open:block" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
          <path d="M5 5l14 14M19 5L5 19" />
        </svg>
      </summary>
      <div class="mt-6 flex flex-col items-start gap-4">
        {links.map(({ href, label }) => <a href={href} class="fancy text-neutral-800!">{label}</a>)}
      </div>
    </details>
    <div class="hidden gap-x-5 md:flex">
      {links.map(({ href, label }) => <a href={href} class="fancy text-neutral-800!">{label}</a>)}
    </div>
  </nav>
</header>
