---
import { Image } from 'astro:assets'
import avatar from '../assets/avatar.webp'

const workHistory = [
  { company: 'Indeed', role: 'Inference Platform' },
  { company: 'Drivemode', role: 'Backend and infrastructure' },
  { company: 'Reaktor Japan', role: 'Full-stack web and iOS' },
  { company: 'Wantedly', role: 'Full-stack web and iOS' },
]
---

<main class="grid gap-x-16 pb-40 sm:pb-48 xl:pb-16 lg:grid-cols-[minmax(0,36rem)_minmax(0,1fr)]">
  <h1 class="mb-8 max-w-xl text-[1.75rem] leading-snug font-normal tracking-tight sm:text-[2rem] lg:mb-10 text-balance">
    Hello! I'm <strong class="font-bold">Anton Van Eechaute</strong>.
  </h1>
  <div class="max-w-xl lg:col-start-1 lg:row-start-2">
    <div class="prose">
      <p>
        I'm a software engineer from Belgium, based in Tokyo,
        building AI systems at{' '}
        <a href="https://third-intelligence.com">Third Intelligence</a>. I enjoy making it easier for others to build software, from
        self-service platforms for engineering teams to tools that help coding
        agents check whether their changes actually work.
      </p>

      <p>
        Outside work, I maintain{' '}
        <a href="https://tadoku.app">Tadoku</a>, a friendly
        contest and tracking platform that helps people build a habit of
        reading and listening in foreign languages. It brings together my
        interest in language learning and my love of building things. It's
        also my playground for exploring technologies I don't get to use at
        work, from infrastructure and backend systems to frontend design.
      </p>
    </div>

    <p class="mt-8 mb-0 leading-7 text-fg-muted">
      Find me on{' '}
      <a href="https://x.com/antonve_be" target="_blank" rel="noreferrer">Twitter</a>,{' '}
      <a href="https://github.com/antonve" target="_blank" rel="noreferrer">GitHub</a>, or{' '}
      <a href="https://www.linkedin.com/in/antonve/" target="_blank" rel="noreferrer">LinkedIn</a>.
    </p>
  </div>

  <section
    aria-labelledby="previously"
    class="mt-10 max-w-xl border-t border-line pt-6 lg:col-start-2 lg:row-start-2 lg:mt-1.5 lg:border-t-0 lg:pt-0"
  >
    <h2 id="previously" class="eyebrow mb-4">Previously</h2>
    <dl class="space-y-4 leading-6">
      {
        workHistory.map(({ company, role }) => (
          <div class="grid grid-cols-[8rem_1fr] gap-x-4 lg:block">
            <dt class="font-semibold">{company}</dt>
            <dd class="text-fg-muted">{role}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {/* Easter egg peeking in from the page's bottom-left corner; the bottom padding keeps it clear of the text. */}
  <Image src={avatar} alt="" width={256} quality={75} class="peek absolute bottom-0 left-0 h-auto w-24 sm:w-32" />
</main>
