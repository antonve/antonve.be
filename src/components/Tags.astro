---
interface Props {
  list: string[]
}

const { list: items } = Astro.props
---

<ul aria-label="Technologies" class="mt-6 flex flex-wrap gap-x-2 gap-y-1 text-sm text-fg-subtle">
  {items.map((it, i) => <li>{it}{i < items.length - 1 ? <span aria-hidden="true" class="ml-2">·</span> : null}</li>)}
</ul>
